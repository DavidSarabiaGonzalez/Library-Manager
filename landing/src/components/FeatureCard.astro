---
interface Props {
  img: string;
  title: string;
  description: string;
  alt: string;
}

const { img, title, description, alt } = Astro.props;
---

<article class="p-7 min-h-64 md:aspect-auto md: border-gray-200 box-border">
  <img src={img} alt={alt} class="w-full h-auto rounded-lg" />
  <h4 class="font-bold text-2xl text-center text-text-primary my-4">{title}</h4>
  <p class="text-text-secondary text-center text-lg text-pretty">
    {description}
  </p>
</article>
